#!/usr/bin/env bash
set -euo pipefail

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${YELLOW}🔍 Checking formatting...${NC}"

if just format --check; then
    echo -e "${GREEN}✨ Format OK. Commit allowed.${NC}"
    exit 0
else
    echo -e "${RED}❌ Formatting issues found. Run: just format${NC}"
    exit 1
fi
